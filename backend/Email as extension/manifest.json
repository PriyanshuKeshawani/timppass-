{
  "manifest_version": 3,
  "name": "Mail Copilot (Standalone Composio)",
  "version": "2.1.3",
  "description": "Minimal Gmail extension: AI Reply, Academic Signature, Attachments, Scheduling & 50-500 Bulk Emails via Composio.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://backend.composio.dev/*",
    "https://api.groq.com/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mail Copilot Settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
